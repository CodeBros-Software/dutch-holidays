{
    "name": "codebros-nl/dutch-holidays",
    "description": "Nederlandse feestdagen en werkdagberekeningen voor Laravel, met cao-/sector-profielen.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "holidays",
        "feestdagen",
        "netherlands",
        "nederland",
        "cao",
        "workdays"
    ],
    "authors": [
        {
            "name": "CodeBros",
            "email": "info@codebros.nl",
            "homepage": "https://codebros.nl"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CodeBros\\DutchHolidays\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeBros\\DutchHolidays\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeBros\\DutchHolidays\\DutchHolidaysServiceProvider"
            ],
            "aliases": {
                "DutchHolidays": "CodeBros\\DutchHolidays\\Facades\\DutchHolidays"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
